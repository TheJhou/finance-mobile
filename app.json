{
  "expo": {
    "name": "Finance App",
    "slug": "finance-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Icone.png",
    "scheme": "financemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0d1b",
        "foregroundImage": "./assets/images/Icone.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thejhou.financeapp",
      "versionCode": 15,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "com.android.vending.BILLING",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Icone.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0f0d1b",
          "dark": {
            "backgroundColor": "#0f0d1b"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/Icone.png",
          "color": "#a78bfa",
          "sounds": []
        }
      ],
      "./modules/bank-notifications/app.plugin",
      "expo-font",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ca5dd76-1bc7-4779-9eb2-cef3b5b90c6d"
      }
    },
    "owner": "thejhou"
  }
}
