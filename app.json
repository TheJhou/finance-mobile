{
  "expo": {
    "name": "Kilun",
    "slug": "finance-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/Icone.png",
    "scheme": "financemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0d1b",
        "foregroundImage": "./assets/images/Icone.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thejhou.kilun",
      "versionCode": 19,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "com.android.vending.BILLING",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Icone.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0f0d1b",
          "dark": {
            "backgroundColor": "#0f0d1b"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o Kilun use o Face ID para proteger o acesso ao aplicativo."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/Icone.png",
          "color": "#a78bfa",
          "sounds": []
        }
      ],
      "./modules/bank-notifications/app.plugin",
      "expo-font",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d5433bf-6079-4962-90f6-70af5bb4c5ac"
      }
    },
    "owner": "jhoutest"
  }
}
