# Backend API URL
# Configure a URL do seu backend aqui
# Para desenvolvimento local: http://localhost:3000
# Para produção: https://seu-backend-url.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Token limits (must match backend FREE_MONTHLY_TOKEN_LIMIT / PRO_MONTHLY_TOKEN_LIMIT)
EXPO_PUBLIC_FREE_TOKEN_LIMIT=100000
EXPO_PUBLIC_PRO_TOKEN_LIMIT=30000000
